rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            'userId', 'authorName', 'rating', 'body', 'createdAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 120
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 10
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'body'])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 10
          && request.resource.data.body.size() <= 2000;
      }
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly([
          'customer', 'products', 'totalAmount', 'status', 'createdAt', 'paymentMethod'
        ])
        && request.resource.data.paymentMethod == 'swish'
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasOnly([
          'name', 'email', 'phone', 'deliveryAddress', 'userId'
        ])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() > 0
        && request.resource.data.customer.name.size() <= 120
        && request.resource.data.customer.email is string
        && request.resource.data.customer.email.size() <= 254
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() <= 40
        && request.resource.data.customer.deliveryAddress is string
        && request.resource.data.customer.deliveryAddress.size() > 0
        && request.resource.data.customer.deliveryAddress.size() <= 500
        && (!request.resource.data.customer.keys().hasAny(['userId'])
          || request.resource.data.customer.userId == null
          || (isSignedIn() && request.resource.data.customer.userId == request.auth.uid))
        && request.resource.data.products is list
        && request.resource.data.products.size() >= 1
        && request.resource.data.products.size() <= 50
        && request.resource.data.products[0] is map
        && request.resource.data.products[0].keys().hasOnly([
          'id', 'name', 'category', 'unitPrice', 'quantity'
        ])
        && request.resource.data.products[0].id is string
        && request.resource.data.products[0].name is string
        && request.resource.data.products[0].name.size() > 0
        && request.resource.data.products[0].name.size() <= 160
        && request.resource.data.products[0].category is string
        && request.resource.data.products[0].category.size() <= 100
        && request.resource.data.products[0].unitPrice is number
        && request.resource.data.products[0].unitPrice > 0
        && request.resource.data.products[0].quantity is int
        && request.resource.data.products[0].quantity >= 1
        && request.resource.data.products[0].quantity <= 99
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in [
          'pending', 'confirmed', 'processing', 'completed', 'cancelled'
        ];
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt']);
      allow update, delete: if isAdmin();

      match /shopperProfiles/{profileId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'cart', 'wishlist', 'viewedProducts', 'searchHistory', 'updatedAt'
          ])
          && request.resource.data.cart is list
          && request.resource.data.cart.size() <= 50
          && request.resource.data.wishlist is list
          && request.resource.data.wishlist.size() <= 50
          && request.resource.data.viewedProducts is list
          && request.resource.data.viewedProducts.size() <= 50
          && request.resource.data.searchHistory is list
          && request.resource.data.searchHistory.size() <= 20;
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'cart', 'wishlist', 'viewedProducts', 'searchHistory', 'updatedAt'
          ])
          && request.resource.data.cart is list
          && request.resource.data.cart.size() <= 50
          && request.resource.data.wishlist is list
          && request.resource.data.wishlist.size() <= 50
          && request.resource.data.viewedProducts is list
          && request.resource.data.viewedProducts.size() <= 50
          && request.resource.data.searchHistory is list
          && request.resource.data.searchHistory.size() <= 20;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /purchases/{purchaseId} {
      allow read, write: if isAdmin();
    }
  }
}
